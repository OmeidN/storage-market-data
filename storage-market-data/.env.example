# Copy to .env and adjust as needed. Do not commit .env.
# This file is for a host venv talking to Compose Postgres on localhost:5433.
# The app container does not use this file — Compose sets DATABASE_URL to
# postgresql+psycopg://storage:storage@db:5432/storage_market_data

# Seconds to wait between requests to the same provider.
# storquest.com/robots.txt has no Crawl-delay, but stay conservative anyway.
REQUEST_DELAY_SECONDS=3

# Where raw responses get saved (host venv; relative to the project root).
# Cloud Run Job should set this to an absolute path on the ephemeral disk, e.g. /tmp/raw
RAW_DATA_DIR=data/raw

LOG_LEVEL=INFO

# Runtime scrape URL (SQLAlchemy + psycopg3).
# Local Compose: host port 5433.
# Cloud Run Job / laptop scrape against Supabase: transaction pooler :6543.
DATABASE_URL=postgresql+psycopg://storage:storage@localhost:5433/storage_market_data

# Alembic only. Optional locally (falls back to DATABASE_URL).
# Against Supabase: direct :5432 (or session pooler :5432 on the pooler host).
# Never point this at the transaction pooler (:6543).
# DATABASE_URL_DIRECT=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
#
# Supabase transaction pooler example (Cloud Run Job / DATABASE_URL):
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
